# Health Resilience Mapping Platform - Environment Variables Template
# Created: January 31, 2025
# Purpose: Environment configuration for local development and production

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
APP_NAME="Health Resilience Mapping API"
APP_VERSION=1.0.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Primary Database (PostgreSQL with PostGIS)
DATABASE_URL=postgres://resilience:resilience_dev_password_2025@localhost:5432/resilience_dev?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resilience_dev
DB_USER=resilience
DB_PASSWORD=resilience_dev_password_2025
DB_SSL_MODE=disable

# =============================================================================
# CACHE CONFIGURATION (Redis)
# =============================================================================

REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# SEARCH ENGINE (Elasticsearch)
# =============================================================================

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================

# Development (MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@resilience-mapping.local

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Configuration
JWT_SECRET=development-jwt-secret-change-in-production-2025
JWT_EXPIRY=24h

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# =============================================================================
# FILE STORAGE
# =============================================================================

STORAGE_TYPE=local
STORAGE_PATH=./storage

# =============================================================================
# MONITORING & METRICS
# =============================================================================

ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# TEAM VALUES REMINDER
# =============================================================================

# This API serves 1,059 resilient communities with dignity and respect.
# Every environment variable should consider community impact and privacy.
# 
# Our Promise:
# - Community data belongs to communities
# - No harm will come from our technology  
# - Beautiful, accessible experiences for all
# - Transparent, ethical data practices
# - Community voices always centered
#
# Questions? Check TEAM_CHARTER.md