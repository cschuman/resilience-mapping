{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:import": "tsx scripts/import-data.ts",
		"db:proxy": "fly proxy 5433:5432 -a resilience-mapping-db"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^25.0.3",
		"csv-parse": "^6.1.0",
		"jsdom": "^27.4.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.4.5",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vitest": "^4.0.16"
	},
	"dependencies": {
		"maplibre-gl": "^5.15.0",
		"pmtiles": "^4.3.2",
		"postgres": "^3.4.7",
		"zod": "^4.2.1"
	}
}
